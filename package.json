{
  "name": "nova",
  "description": "Nova AI IDE",
  "main": "dist/main/main.js",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json && node scripts/build-renderer.js && npm run copy:renderer && npm run copy:monaco",
    "copy:renderer": "node -e \"const fs=require('fs');const p=require('path');fs.mkdirSync('dist/renderer/assets',{recursive:true});fs.copyFileSync('src/renderer/index.html','dist/renderer/index.html');fs.copyFileSync('src/renderer/assets/miranova_studios.png','dist/renderer/assets/miranova_studios.png');fs.copyFileSync('src/renderer/monaco-loader.js','dist/renderer/monaco-loader.js');fs.copyFileSync('src/renderer/monaco-init.js','dist/renderer/monaco-init.js');\"",
    "copy:monaco": "node scripts/copy-monaco.js",
    "start": "npm run clean && npm run build && electron ./dist/main/main.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts --config .eslintrc.js",
    "lint:fix": "eslint src --ext .ts --fix --config .eslintrc.js",
    "fmt": "prettier --write \"src/**/*.{ts,html,css}\"",
    "fmt:check": "prettier --check \"src/**/*.{ts,html,css}\"",
    "pack:win": "npm run clean && npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false ELECTRON_BUILDER_NSIS_SKIP_SIGNING=true electron-builder --win portable",
    "pack:win:exe": "npm run clean && npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false ELECTRON_BUILDER_NSIS_SKIP_SIGNING=true electron-builder --win nsis"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aeonath4/nova.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Aeonath4/nova/issues"
  },
  "homepage": "https://github.com/Aeonath4/nova#readme",
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.7.2",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "cross-env": "^10.1.0",
    "electron": "^38.2.2",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.25.12",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3"
  },
  "build": {
    "productName": "Nova",
    "appId": "studio.miranova.nova",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "compression": "store",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "version": "0.2.0",
  "dependencies": {
    "@lydell/node-pty": "^1.1.0",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "chokidar": "^4.0.3",
    "monaco-editor": "^0.54.0",
    "node-gyp": "^11.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
